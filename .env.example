# ---------------------------------------------------------------------------
# Pricele environment configuration. Copy to .env.local and fill in.
# Never commit real values. Variables without NEXT_PUBLIC_ are server-only.
# ---------------------------------------------------------------------------

# Public base URL of the site (used for auth redirects, share links, metadata).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project URL and publishable key (Project Settings -> API Keys).
# The legacy anon JWT also works: set NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key (sb_secret_...). SERVER ONLY. Bypasses RLS.
# The legacy service_role JWT also works: set SUPABASE_SERVICE_ROLE_KEY instead.
SUPABASE_SECRET_KEY=

# Google OAuth. The client ID/secret are configured in Supabase (Dashboard -> Authentication ->
# Providers -> Google), or for the local stack via SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID /
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET (see supabase/config.toml). They are listed here for
# reference only; the app never reads them. Set the flag below to show the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Used ONLY by `npm run admin:grant` (one-time, idempotent). Never grants access at signup.
ADMIN_BOOTSTRAP_EMAIL=

# Bearer secret for /api/cron/daily (>= 32 random characters, e.g. `openssl rand -hex 32`).
CRON_SECRET=

# Optional AI drafting assistant for admins (Anthropic API key). Leave empty to disable.
AI_PROVIDER_API_KEY=
AI_MODEL=claude-sonnet-5-5

# Advertising is disabled until a provider is deliberately configured.
ADVERTISING_ENABLED=false
AD_PROVIDER=
AD_PUBLISHER_ID=

# Optional public contact address shown on /about. If empty, the feedback form is shown.
NEXT_PUBLIC_CONTACT_EMAIL=
