# Pricele environment variables. Copy to .env.local for local development.
# Never commit real values. Variables prefixed NEXT_PUBLIC_ are sent to the browser.

# --- Required everywhere --------------------------------------------------------
# Public URL of the site (auth redirects, share links, metadata). Optional on Vercel, which
# supplies its production address automatically; set it when you add a custom domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project URL and *publishable* key (sb_publishable_...). The legacy anon key
# also works via NEXT_PUBLIC_SUPABASE_ANON_KEY. Both are safe to expose.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Postgres connection for the least-privilege `pricele_app` role.
# Production: use the Supabase *transaction pooler* string (port 6543), e.g.
#   postgres://pricele_app.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Local (npm run db:local): postgres://pricele_app:pricele_app_local_test@127.0.0.1:5432/pricele_dev
DATABASE_URL=

# --- Required in production -----------------------------------------------------
# Shared secret for the scheduled publication check (Vercel Cron sends it as a Bearer token).
# Generate with: openssl rand -hex 32
CRON_SECRET=

# --- Admin scripts only (never set in the web app's environment) ------------------
# Database OWNER connection, used by `npm run admin:bootstrap|grant|revoke` from your machine.
# DATABASE_ADMIN_URL=postgres://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# --- Optional -------------------------------------------------------------------
# Google OAuth is configured in the Supabase dashboard (Auth > Providers > Google);
# the Google client ID/secret live there, not in this app.

# AI drafting assistant for admins (Anthropic API). Leave blank to disable.
AI_PROVIDER_API_KEY=
AI_MODEL=claude-sonnet-5-5

# Advertising is off until a provider is deliberately configured.
ADVERTISING_ENABLED=false
AD_PROVIDER=
AD_PUBLISHER_ID=

# Guest session lifetime in days (1-90).
GUEST_SESSION_TTL_DAYS=30

# Not used: the app never needs the Supabase service-role key. If you add it for other
# tooling, keep it server-only and never prefix it with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=
